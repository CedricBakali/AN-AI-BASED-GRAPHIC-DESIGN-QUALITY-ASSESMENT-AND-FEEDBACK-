@startuml

skinparam DefaultFontSize 30
skinparam BackgroundColor transparent


title Use Case Diagram - DesignScore

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Normal User" as User
actor "Administrator" as Admin

rectangle "DesignScore System" {

    usecase "Register Account" as UC1
    usecase "Login" as UC2
    usecase "View Dashboard" as UC3
    usecase "Upload Graphic Design" as UC4
    usecase "Analyse Design" as UC5
    usecase "View Assessment Results" as UC6
    usecase "View AI Feedback" as UC7
    usecase "View Assessment History" as UC8
    usecase "Manage Profile" as UC9
    usecase "Logout" as UC10

    usecase "Admin Login" as UC11
    usecase "View Admin Dashboard" as UC12
    usecase "Manage Users" as UC13
    usecase "View User Assessments" as UC14
    usecase "Monitor System Activity" as UC15
    usecase "View Reports and Statistics" as UC16
    usecase "Manage System Data" as UC17
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7
User --> UC8
User --> UC9
User --> UC10

Admin --> UC11
Admin --> UC12
Admin --> UC13
Admin --> UC14
Admin --> UC15
Admin --> UC16
Admin --> UC17
Admin --> UC10

UC5 ..> UC4 : <<include>>
UC6 ..> UC5 : <<include>>
UC7 ..> UC6 : <<include>>

UC12 ..> UC11 : <<include>>
UC13 ..> UC12 : <<include>>
UC14 ..> UC12 : <<include>>
UC15 ..> UC12 : <<include>>
UC16 ..> UC12 : <<include>>

@enduml